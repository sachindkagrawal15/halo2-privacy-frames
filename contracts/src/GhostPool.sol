pragma solidity 0.8.28;

import {
    HegotaSupport, Devnet, Scope, TxParam, FrameParam, FrameMode
} from "@forshtat/hegota-support/contracts/HegotaSupport.sol";
import {PoseidonMerkleTree} from "./PoseidonMerkleTree.sol";

interface IStakingRegistry {
    function addStake(uint32 unstakeDelaySec) external payable;
}

/// @title GhostPool
/// @notice A fixed-denomination shielded ETH pool whose withdrawals pay their own gas.
/// @dev A withdrawal is an EIP-8141 frame transaction whose sender and payer is this contract:
///
///     frame 0  VERIFY  this.validateWithdrawal(proof, root)          checks everything, then APPROVE
///     frame 1  SENDER  this.withdraw(nullifierHash, recipient, fee)  pays recipient, keeps fee
///
/// A Halo2 proof stands in for a signature, so a brand-new address with no ETH can withdraw without a
/// relayer. The pool pays the gas from its balance and keeps `fee`, which the proof binds and which
/// must cover the transaction's maximum cost, so a withdrawal can never cost the pool money.
/// The proof check needs far more gas than the canonical mempool allows a validation frame (100k),
/// so withdrawals go through the ERC-8421 alternative mempool, which this contract stakes into.
contract GhostPool is HegotaSupport(Devnet.ERC8421_WORKSHOP), PoseidonMerkleTree {
    /// Every deposit and every withdrawal moves exactly this much ETH.
    uint256 public immutable denomination;
    /// Generated by snark-verifier; called with `abi.encodePacked(publicInputs, proof)`, reverts unless valid.
    address public immutable verifier;
    /// The least gas frame 1 may carry, so `withdraw` cannot be made to run out of gas after approval.
    uint256 public immutable minWithdrawExecutionGas;
    uint256 public immutable minWithdrawStateGas;

    /// Gas given to the recipient's code. An EOA needs none; a reverting contract only gets `owed`.
    uint256 internal constant PAYOUT_GAS = 30_000;
    /// withdraw(bytes32,address,uint256): selector plus three words.
    uint256 internal constant WITHDRAW_CALLDATA_LENGTH = 4 + 3 * 32;

    mapping(bytes32 commitment => bool) public commitments;
    mapping(bytes32 nullifierHash => bool) public nullifierSpent;
    mapping(address recipient => uint256) public owed;

    event Deposit(bytes32 indexed commitment, uint32 leafIndex, uint256 timestamp);
    event Withdrawal(address indexed recipient, bytes32 indexed nullifierHash, uint256 fee, bool delivered);

    error WrongAmount();
    error NotAFieldElement();
    error DuplicateCommitment();
    error BadFrames();
    error GasTooLow();
    error FeeTooLow();
    error FeeTooHigh();
    error UnknownRoot();
    error NullifierSpent();
    error InvalidProof();
    error OnlyThroughFrameTransaction();
    error NothingOwed();
    error TransferFailed();

    /// @param stakingRegistry ERC-8421 staking registry; `msg.value` is staked there for this contract,
    /// which lifts the alternative mempool's validation gas cap for the pool from 250k to 2.5M.
    constructor(
        address verifier_,
        uint256 denomination_,
        uint256 minWithdrawExecutionGas_,
        uint256 minWithdrawStateGas_,
        address stakingRegistry,
        uint32 unstakeDelaySec
    ) payable {
        verifier = verifier_;
        denomination = denomination_;
        minWithdrawExecutionGas = minWithdrawExecutionGas_;
        minWithdrawStateGas = minWithdrawStateGas_;
        if (msg.value > 0) IStakingRegistry(stakingRegistry).addStake{value: msg.value}(unstakeDelaySec);
    }

    /// @notice Stakes `msg.value` for this pool in an ERC-8421 staking registry. The registry keys
    /// stake by `msg.sender`, so the pool has to make the call itself; anyone may fund it, and the
    /// pool's own balance is never touched. Lets a pool deployed before its registry existed stake later.
    function stake(address stakingRegistry, uint32 unstakeDelaySec) external payable {
        IStakingRegistry(stakingRegistry).addStake{value: msg.value}(unstakeDelaySec);
    }

    /// @notice Deposits `denomination` ETH under `commitment = Poseidon(nullifier, secret)`.
    function deposit(bytes32 commitment) external payable {
        if (msg.value != denomination) revert WrongAmount();
        if (uint256(commitment) >= FIELD_SIZE) revert NotAFieldElement();
        if (commitments[commitment]) revert DuplicateCommitment();
        commitments[commitment] = true;
        uint32 leafIndex = _insert(commitment);
        emit Deposit(commitment, leafIndex, block.timestamp);
    }

    /// @notice Frame 0 of a withdrawal. Approves execution and payment only for a transaction that
    /// pays out a valid, unspent note and reimburses the pool for every unit of gas it could burn.
    /// @dev Runs in a VERIFY frame, which is static: it reads only this contract's storage, which is
    /// the sender's own storage and so allowed by every mempool rule set.
    function validateWithdrawal(bytes calldata proof, bytes32 root) external {
        // The transaction is exactly [VERIFY(this), SENDER(this).withdraw(...)]: nobody can attach a
        // frame that spends the pool's ETH or calls anything else as the pool.
        if (
            txparam(TxParam.FRAME_COUNT) != 2 || frameparam(1, FrameParam.MODE) != uint256(FrameMode.SENDER)
                || frameparam(1, FrameParam.RESOLVED_TARGET) != uint256(uint160(address(this)))
                || frameparam(1, FrameParam.VALUE) != 0
                || frameparam(1, FrameParam.DATA_LENGTH) != WITHDRAW_CALLDATA_LENGTH
                || bytes4(framedataload(0, 1)) != this.withdraw.selector
        ) revert BadFrames();

        // The payout parameters come from frame 1 itself, so the proof is checked against what will run.
        bytes32 nullifierHash = framedataload(4, 1);
        uint256 recipientWord = uint256(framedataload(36, 1));
        uint256 fee = uint256(framedataload(68, 1));
        // A dirty address word would make withdraw's ABI decoding revert after approval.
        if (recipientWord >> 160 != 0) revert BadFrames();

        if (
            frameparam(1, FrameParam.EXECUTION_GAS_LIMIT) < minWithdrawExecutionGas
                || frameparam(1, FrameParam.STATE_GAS_LIMIT) < minWithdrawStateGas
        ) revert GasTooLow();
        if (fee > denomination) revert FeeTooHigh();
        if (txparam(TxParam.MAX_COST) > fee) revert FeeTooLow();
        if (!isKnownRoot[root]) revert UnknownRoot();
        if (nullifierSpent[nullifierHash]) revert NullifierSpent();

        (bool valid,) = verifier.staticcall(abi.encodePacked(root, nullifierHash, recipientWord, fee, proof));
        if (!valid) revert InvalidProof();

        approve(Scope.EXECUTION_AND_PAYMENT);
    }

    /// @notice Frame 1 of a withdrawal: reachable only inside a transaction `validateWithdrawal` approved.
    /// @dev Never reverts after approval: a recipient that refuses ETH is credited in `owed` instead,
    /// so a note owner cannot make the pool pay for failed withdrawals over and over.
    function withdraw(bytes32 nullifierHash, address payable recipient, uint256 fee) external {
        if (msg.sender != address(this)) revert OnlyThroughFrameTransaction();
        if (nullifierSpent[nullifierHash]) revert NullifierSpent();
        nullifierSpent[nullifierHash] = true;

        uint256 amount = denomination - fee;
        (bool delivered,) = recipient.call{value: amount, gas: PAYOUT_GAS}("");
        if (!delivered) owed[recipient] += amount;
        emit Withdrawal(recipient, nullifierHash, fee, delivered);
    }

    /// @notice Collects a payout that `withdraw` could not deliver.
    function claim() external {
        uint256 amount = owed[msg.sender];
        if (amount == 0) revert NothingOwed();
        owed[msg.sender] = 0;
        (bool sent,) = payable(msg.sender).call{value: amount}("");
        if (!sent) revert TransferFailed();
    }
}
